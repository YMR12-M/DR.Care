# DR.Care environment example
# Rename this file to .env and update values before using the app.

# Enable automatic creation of the default admin account on first run.
# Set to 1 only during initial setup and use a strong password.
# When set to 0, the default admin can still be initialized manually via api/admin-init.php.
DRCARE_DEFAULT_ADMIN_AUTO_CREATE=0
DRCARE_DEFAULT_ADMIN_USER=admin
DRCARE_DEFAULT_ADMIN_PASS=replace-with-strong-password
DRCARE_NOTIFICATION_EMAIL=admin@example.com

# Recommended app origin for API access.
DRCARE_APP_ORIGIN=http://localhost

# Email sender details (used by SMTP mailer if enabled)
DRCARE_EMAIL_FROM=notifications@example.com
DRCARE_EMAIL_NAME="DR.Care Notifications"

# SMTP settings
MAILER_SMTP_HOST=smtp.example.com
MAILER_SMTP_PORT=587
MAILER_SMTP_SECURITY=starttls
MAILER_SMTP_USERNAME=your-smtp-username
MAILER_SMTP_PASSWORD=your-smtp-password

# POS token — REQUIRED for CarWash-POS to work.
# Must be at least 32 characters. Generate a secure one with:
#   openssl rand -hex 32
# Sent as X-POS-Token header (never in URL query string).
POS_TOKEN=replace-with-output-of-openssl-rand-hex-32

# Java integration for server-side pricing calculations
DRCARE_JAVA_CMD=java
DRCARE_JAVAC_CMD=javac

# WhatsApp (Meta Cloud API) — optional, sends booking confirmations & status updates to customers
# 1. Create a Meta Business app at https://developers.facebook.com
# 2. Add "WhatsApp" product and get a Phone Number ID + permanent token
WHATSAPP_API_TOKEN=your-meta-whatsapp-bearer-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
